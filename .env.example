# Oracle Authentication (From your ~/.oci/config file)
OCI_USER_ID=ocid1.user.oc1..xxxxxxx
OCI_TENANT_ID=ocid1.tenancy.oc1..xxxxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=ap-mumbai-1
OCI_KEY_CONTENT="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Oracle Compute Provisioning Targets
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxxxxxx
OCI_SUBNET_ID=ocid1.subnet.oc1..xxxxxxx
OCI_IMAGE_ID=ocid1.image.oc1..xxxxxxx

# Your Public Key string (To log into the new instance)
OCI_SSH_PUBLIC_KEY="ssh-rsa AAAA..."
